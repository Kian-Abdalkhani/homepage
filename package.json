{
  "name": "abdalkhani-homepage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "predev": "node scripts/sync-brand-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-brand-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "brand:preview": "node scripts/render-social-preview.mjs",
    "preview": "vite preview",
    "test:browser": "npm run build && playwright test",
    "test:browser:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "@abdalkhani/homelab-theme": "0.1.0",
    "@abdalkhani/react-ui": "0.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
